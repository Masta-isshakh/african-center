# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Render sample testimonials, projects and material prices (never enable in production)
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false
# Analytics — leave empty to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
